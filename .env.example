# Copy to .env for local dev. On Vercel, add these under Project → Settings → Environment Variables.

# Required (or each user can paste their own key in the app's Settings)
OPENAI_API_KEY=sk-...
# Optional: defaults to gpt-4o-mini
OPENAI_MODEL=gpt-4o-mini

# Optional: lets the app send from this Gmail account without users entering credentials.
# Use a Google App Password, NOT your normal password: https://myaccount.google.com/apppasswords
EMAIL=you@gmail.com
EMAIL_PASS=abcd efgh ijkl mnop
# Optional for non-Gmail providers
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=465

# Strongly recommended if you set OPENAI_API_KEY or EMAIL_PASS above:
# visitors must enter this password before the app will use your keys.
APP_PASSWORD=choose-something-long

# Optional: more live job listings (India by default). Free key at https://developer.adzuna.com
ADZUNA_APP_ID=
ADZUNA_APP_KEY=
ADZUNA_COUNTRY=in
