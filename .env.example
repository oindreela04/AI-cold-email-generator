# Copy to .env for local dev. On Vercel, add these under Project → Settings → Environment Variables.

# AI — Groq is FREE (no credit card): create a key at https://console.groq.com/keys
# If you leave this out, each user pastes their own free key in the app's Settings.
GROQ_API_KEY=gsk_...

# Alternatives (set one of these instead, or AI_PROVIDER to choose explicitly):
# GEMINI_API_KEY=...        # free tier: https://aistudio.google.com/apikey
# OPENAI_API_KEY=sk-...     # paid
# AI_PROVIDER=groq          # groq | gemini | openai
# AI_MODEL=openai/gpt-oss-120b   # override the default model

# Optional: lets the app send from this Gmail account without users entering credentials.
# Use a Google App Password, NOT your normal password: https://myaccount.google.com/apppasswords
EMAIL=you@gmail.com
EMAIL_PASS=abcd efgh ijkl mnop
# Optional for non-Gmail providers
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=465

# Recommended if you set an AI key or EMAIL_PASS above:
# visitors must enter this password before the app will use your keys.
APP_PASSWORD=choose-something-long

# Optional: more live job listings (India by default). Free key at https://developer.adzuna.com
ADZUNA_APP_ID=
ADZUNA_APP_KEY=
ADZUNA_COUNTRY=in
